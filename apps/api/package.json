{
  "name": "@setrya/api",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "owner:reset-password": "tsx --env-file=.env.local scripts/owner-reset-password.ts",
    "restore-backup": "tsx --env-file=.env.local scripts/restore-backup.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@node-rs/argon2": "2.0.2",
    "@setrya/db": "workspace:*",
    "@setrya/domain": "workspace:*",
    "@setrya/security": "workspace:*",
    "@setrya/wallet-adapter": "workspace:*",
    "drizzle-orm": "0.44.7",
    "hono": "4.13.13",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.5",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
