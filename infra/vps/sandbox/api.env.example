# Sandbox stack: copy to sandbox/api.env (mode 0600). Generated by TARGET_DIR=sandbox infra/vps/bootstrap.sh.
NODE_ENV=production
HOST=0.0.0.0
PORT=8444
SETRYA_PUBLIC_ORIGIN=https://setrya.example
SETRYA_EDGE_KEY=
SETRYA_TLS_CERT_FILE=/run/setrya/tls.crt
SETRYA_TLS_KEY_FILE=/run/setrya/tls.key
DATABASE_URL=postgres://setrya:PASSWORD@db:5432/setrya
SETRYA_MASTER_KEY_FILE=/run/setrya/master.key
SETRYA_SETUP_TOKEN=
SETRYA_NETWORK=testnet
SETRYA_LOG_LEVEL=info

# The signer speaks the Zallet wallet and Zebra chain RPC subsets, so both point at it.
SETRYA_WALLET_CONNECTION_NAME=Sandbox signer (lightwalletd)
ZALLET_RPC_URL=http://172.31.78.10:28232
ZALLET_RPC_COOKIE_FILE=/run/signer/.cookie
ZEBRA_RPC_URL=http://172.31.78.10:28232
ZEBRA_RPC_COOKIE_FILE=/run/signer/.cookie
SETRYA_PAYER_ACCOUNT_UUID=
SETRYA_FUND_SOURCE=orchard
SETRYA_RPC_TIMEOUT_MS=30000
SETRYA_PROVE_TIMEOUT_MS=600000

# Public testnet sandbox. The owner is created on first start from these values; nobody signs in to it by hand.
SETRYA_SANDBOX=1
SETRYA_SANDBOX_OWNER_EMAIL=sandbox@setrya.invalid
SETRYA_SANDBOX_OWNER_PASSWORD=
SETRYA_SANDBOX_VAULT_PASSPHRASE=
# Each claimant receives this many zatoshis (1,000,000 = 0.01 TAZ). At most 5,000,000.
SETRYA_SANDBOX_PAYOUT_ZAT=1000000
# Optional: pay the second sample partner here instead of back into the sandbox wallet.
# SETRYA_SANDBOX_HOUSE_ADDRESS=
