# Copy to api.env on the settlement host (mode 0600). Generated by infra/vps/bootstrap.sh.
NODE_ENV=production
HOST=0.0.0.0
PORT=8444
SETRYA_PUBLIC_ORIGIN=https://setrya.example
SETRYA_EDGE_KEY=
SETRYA_TLS_CERT_FILE=/run/setrya/tls.crt
SETRYA_TLS_KEY_FILE=/run/setrya/tls.key
DATABASE_URL=postgres://setrya:PASSWORD@db:5432/setrya
SETRYA_MASTER_KEY_FILE=/run/setrya/master.key
SETRYA_SETUP_TOKEN=
SETRYA_NETWORK=testnet
SETRYA_LOG_LEVEL=info

# The signer speaks the Zallet wallet and Zebra chain RPC subsets, so both point at it.
SETRYA_WALLET_CONNECTION_NAME=Setrya signer (lightwalletd)
ZALLET_RPC_URL=http://172.31.77.10:28232
ZALLET_RPC_COOKIE_FILE=/run/signer/.cookie
ZEBRA_RPC_URL=http://172.31.77.10:28232
ZEBRA_RPC_COOKIE_FILE=/run/signer/.cookie
SETRYA_PAYER_ACCOUNT_UUID=
SETRYA_FUND_SOURCE=orchard
SETRYA_RPC_TIMEOUT_MS=30000
SETRYA_PROVE_TIMEOUT_MS=600000
